npc = {}


--古玩鉴定（新逻辑：配置在 teshudata）

local _config = Guard.getConfig("npc_65")

local _state_key = VarCfg["T_古玩鉴定"] or "T63"

local function _get_cfg(path, default)
    local v = _config
    for _, k in ipairs(path) do
        if not v then
            return default
        end
        v = v[k]
    end
    if v == nil then
        return default
    end
    return v
end

local function _get_state(play)
    local raw = getplaydef(play, _state_key)
    if not raw or raw == "" then
        return nil
    end
    local ok, data = pcall(json2tbl, raw)
    if not ok then
        return nil
    end
    return data
end

local function _set_state(play, data)
    if not data then
        setplaydef(play, _state_key, "")
        return
    end
    setplaydef(play, _state_key, tbl2json(data))
end

local function _clear_state(play)
    setplaydef(play, _state_key, "")
end

local function _get_item_cfg(idx)
    if not (_config and _config.config and _config.config[idx]) then
        return nil
    end
    return _config.config[idx]
end

local function _get_unid_item_name(cfg)
    if cfg and cfg.unid_item then
        return cfg.unid_item
    end
    if cfg and cfg.cost and cfg.cost[1] and cfg.cost[1][1] then
        return cfg.cost[1][1]
    end
    return nil
end
local function _check_cost(play, cost)
    if not cost or #cost == 0 then
        return true
    end
    local name, num = Player.checkItemNumByTable(play, cost)
    if name then
        Player.sendmsgEx(play, string.format("你的#57|【%s】#218|不足：#57|【%d】#218|", name, num))
        return false
    end
    return true
end

local function _consume_cost(play, cost, reason)
    if not cost or #cost == 0 then
        return
    end
    Player.takeItemByTable(play, cost, ","..(reason or "古玩鉴定"), nil)
end

local function _pick_era_by_weight(era_weight)
    local total = 0
    for i = 1, #era_weight do
        total = total + (era_weight[i] or 0)
    end
    local rnd = math.random(total)
    local acc = 0
    for i = 1, #era_weight do
        acc = acc + (era_weight[i] or 0)
        if rnd <= acc then
            return i
        end
    end
    return #era_weight
end

local function _up_era(era, max_era)
    if era <= 1 then
        return 1
    end
    return math.max(1, (era or 1) - 1)
end

local function _down_era(era, max_era)
    local m = max_era or 6
    if era >= m then
        return m
    end
    return math.min(m, (era or m) + 1)
end
local function _give_antique(play, base_name, era_idx)
    local eras = _get_cfg({"eras"}, {"唐代","宋代","元代","明代","清代","近代"})
    local era_name = eras[era_idx] or "近代"
    local item_name = string.format("【%s】%s", era_name, base_name)
    giveitem(play, item_name, 1, 850)
    return item_name
end

local function _give_fake(play, base_name)
    local item_name = string.format("【赝品】%s", base_name)
    giveitem(play, item_name, 1, 850)
    return item_name
end
local function _roll_success(rate)
    local r = math.random(100)
    return r <= (rate or 0)
end

function npc.main(play,npcid)
    if not _config then
        return
    end
    local data = {}
    data.gwjd = _get_state(play)
    sendluamsg(play,100,npcid,0,0,tbl2json(data))
end

function npc.link(play,npcid,ew,aid,data)
    if not _config then
        return
    end
    -- npc_guard: 入参校验
    if not Guard.ensurePlayer(play, npcid) then
        return
    end
    local __guardAction = Guard.normalizeAction(play, npcid, ew)
    if __guardAction == nil then
        return
    end
    ew = __guardAction
    -- npc_guard: 操作白名单（优化：限定合法操作编号）
    local __guardAllowedActions = Guard.newActionSet({1,2,3,4,5,6})
    if not Guard.ensureActionAllowed(play, npcid, ew, __guardAllowedActions) then
        return
    end

    if data == "" then
        data = "{}"
    end
    local json_data = json2tbl(data) or {}
    local idx = tonumber(json_data.idx)
    local use_protect = tonumber(json_data.use_protect or 0) == 1

    if idx then
        local cfg = _get_item_cfg(idx)
        if not cfg then
            Player.sendmsgEx(play, "参数错误#57")
            return
        end
    end

    local state = _get_state(play)

    if ew == 1 then -- 鉴定真伪
        if state and state.active == 1 then
            Player.sendmsgEx(play, "你还有未完成的古玩鉴定#57")
            return
        end
        if not idx then
            Player.sendmsgEx(play, "参数错误#57")
            return
        end
        local cfg = _get_item_cfg(idx)
        local base_name = cfg and cfg.name or ""
        local unid_item = _get_unid_item_name(cfg)
        if not unid_item then
            Player.sendmsgEx(play, "配置缺失#57")
            return
        end
        local identify_cost = _get_cfg({"cost","identify"}, {})
        local cost = { {unid_item,1} }
        for _, v in ipairs(identify_cost) do
            table.insert(cost, v)
        end
        if not _check_cost(play, cost) then
            return
        end
        _consume_cost(play, cost, "古玩鉴定")

        local true_rate = _get_cfg({"true_rate"}, 90)
        if not _roll_success(true_rate) then
            local item_name = string.format("【赝品】%s", base_name)
            state = { active = 1, idx = idx, era = 6, stage = 0, can_final = 0, collect_pending = 1, pending_fake = 1 }
            _set_state(play, state)
            Player.sendmsgEx(play, "很遗憾，本件古玩是赝品#57")
            sendluamsg(play,100,npcid,1,0,tbl2json({stage=0,result="fake",item=item_name,idx=idx,collect=1}))
            return
        end

        local era_weight = _get_cfg({"era_weight"}, {1,6,16,26,31,20})
        local era_idx = _pick_era_by_weight(era_weight)
        state = { active = 1, idx = idx, era = era_idx, stage = 1, can_final = 0 }
        _set_state(play, state)
        Player.sendmsgEx(play, "恭喜你，本件古玩是真品#250")
        sendluamsg(play,100,npcid,1,0,tbl2json({stage=1,result="true",era=era_idx,idx=idx}))
        return
    end

    if not state or state.active ~= 1 then
        Player.sendmsgEx(play, "暂无可操作的古玩鉴定记录#57")
        return
    end

    if idx and state.idx ~= idx then
        Player.sendmsgEx(play, "该古玩与当前鉴定记录不一致#57")
        return
    end

    local cfg = _get_item_cfg(state.idx)
    local base_name = cfg and cfg.name or ""
    
    if ew == 2 then -- 保守鉴定（确定年份）
        if state.stage ~= 1 then
            Player.sendmsgEx(play, "当前阶段无法进行保守鉴定#57")
            return
        end
        local cost = _get_cfg({"cost","conservative"}, {})
        if not _check_cost(play, cost) then
            return
        end
        _consume_cost(play, cost, "古玩鉴定")
        local item_name = string.format("【%s】%s", _get_cfg({"eras"}, {"唐代","宋代","元代","明代","清代","近代"})[state.era] or "近代", base_name)
        state.collect_pending = 1
        state.pending_fake = 0
        _set_state(play, state)
        Player.sendmsgEx(play, "保守鉴定完成，请点击结果领取古玩#57")
        sendluamsg(play,100,npcid,1,0,tbl2json({stage=2,result="conservative",item=item_name,era=state.era,idx=state.idx,collect=1}))
        return
    elseif ew == 3 then -- 断代鉴定（初次升级）
        if state.stage ~= 1 then
            Player.sendmsgEx(play, "当前阶段无法进行断代鉴定#57")
            return
        end
        local cost = _get_cfg({"cost","segment"}, {})
        if not _check_cost(play, cost) then
            return
        end
        _consume_cost(play, cost, "古玩鉴定")

        local segment_rate = _get_cfg({"segment_rate"}, {})
        local success = _roll_success(segment_rate[state.era] or 0)
        local new_era = state.era
        if success then
            new_era = _up_era(state.era)
            state.can_final = 1
        else
            local protect_item = _get_cfg({"protect_item","segment"}, "断代护符")
            if use_protect and _check_cost(play, {{protect_item,1}}) then
                _consume_cost(play, {{protect_item,1}}, "古玩鉴定护符")
                new_era = state.era
            else
                new_era = _down_era(state.era, #_get_cfg({"eras"}, {"唐代","宋代","元代","明代","清代","近代"}))
            end
            state.can_final = 0
        end
        state.era = new_era
        state.stage = 2
        _set_state(play, state)

        local msg = success and "断代鉴定成功，古玩年代+1级" or "断代鉴定失败，古玩年代-1级"
        Player.sendmsgEx(play, msg)
        sendluamsg(play,100,npcid,1,0,tbl2json({stage=2,result="segment",success=success,era=state.era,can_final=state.can_final,idx=state.idx}))
        return
    elseif ew == 4 then -- 终极鉴定（2次升级）
        if state.stage ~= 2 or state.can_final ~= 1 then
            Player.sendmsgEx(play, "当前阶段无法进行终极鉴定#57")
            return
        end
        local cost = _get_cfg({"cost","final"}, {})
        if not _check_cost(play, cost) then
            return
        end
        _consume_cost(play, cost, "古玩鉴定")

        local final_rate = _get_cfg({"final_rate"}, {})
        local success = _roll_success(final_rate[state.era] or 0)
        local new_era = state.era
        if success then
            new_era = _up_era(state.era)
        else
            local protect_item = _get_cfg({"protect_item","final"}, "终鉴护符")
            if use_protect and _check_cost(play, {{protect_item,1}}) then
                _consume_cost(play, {{protect_item,1}}, "古玩鉴定护符")
                new_era = state.era
            else
                new_era = _down_era(state.era, #_get_cfg({"eras"}, {"唐代","宋代","元代","明代","清代","近代"}))
            end
        end
        state.era = new_era

        local msg = success and "终极鉴定成功，古玩年代+1级" or "终极鉴定失败，古玩年代-1级"
        local item_name = string.format("【%s】%s", _get_cfg({"eras"}, {"唐代","宋代","元代","明代","清代","近代"})[state.era] or "近代", base_name)
        state.stage = 2
        state.collect_pending = 1
        state.pending_fake = 0
        _set_state(play, state)
        Player.sendmsgEx(play, msg)
        sendluamsg(play,100,npcid,1,0,tbl2json({stage=2,result="segment",success=success,era=state.era,idx=state.idx,collect=1,can_final=0}))
        return
    elseif ew == 5 then -- 收下古玩：只打开本次鉴定结果页，不直接发物品
        if state.stage ~= 2 and state.collect_pending ~= 1 then
            Player.sendmsgEx(play, "当前阶段无法收下古玩#57")
            return
        end
        state.collect_pending = 1
        state.pending_fake = state.pending_fake or 0
        _set_state(play, state)
        local item_name
        if state.pending_fake == 1 then
            item_name = string.format("【赝品】%s", base_name)
        else
            item_name = string.format("【%s】%s", _get_cfg({"eras"}, {"唐代","宋代","元代","明代","清代","近代"})[state.era] or "近代", base_name)
        end
        Player.sendmsgEx(play, "请点击结果领取古玩#57")
        sendluamsg(play,100,npcid,1,0,tbl2json({stage=2,result="collect_preview",item=item_name,era=state.era,idx=state.idx,collect=1}))
        return
    elseif ew == 6 then -- 结果页点击物品后，才真正发放古玩
        if state.collect_pending ~= 1 then
            Player.sendmsgEx(play, "暂无可领取的古玩#57")
            return
        end
        local item_name
        if state.pending_fake == 1 then
            item_name = _give_fake(play, base_name)
        else
            item_name = _give_antique(play, base_name, state.era)
        end
        _clear_state(play)
        Player.sendmsgEx(play, string.format("你获得了|【%s】#218|", item_name))
        sendluamsg(play,100,npcid,1,0,tbl2json({stage=3,result="collect",item=item_name,era=state.era,idx=state.idx}))
        return
    end
end


return npc
