local function _advance_huangquan_refine(data)
    local state = _get_huangquan_state()
    local startAt = _toint(state.start_at)
    local endAt = _toint(state.end_at)
    local ref = type(data.refine) == "table" and data.refine or nil
    if not ref or tostring(ref.stone or "") == "" or startAt <= 0 or endAt <= startAt then return false end
    local now = _now()
    local lastAt = math.max(startAt, _toint(ref.huangquan_tick_at))
    local stopAt = math.min(now, endAt)
    local changed = false
    if stopAt > lastAt then
        local totalBonus = (stopAt - lastAt) * _huangquan_refine_rate + (tonumber(ref.huangquan_bonus_carry) or 0)
        local bonusSec = math.floor(totalBonus)
        ref.huangquan_bonus_carry = totalBonus - bonusSec
        ref.huangquan_tick_at = stopAt
        if bonusSec > 0 then ref.end_at = math.max(0, _toint(ref.end_at) - bonusSec) end
        changed = true
    end
    if now >= endAt and (_toint(ref.huangquan_tick_at) > 0 or tonumber(ref.huangquan_bonus_carry or 0) > 0) then
        ref.huangquan_tick_at = nil
        ref.huangquan_bonus_carry = nil
        changed = true
    end
    return changed
end

